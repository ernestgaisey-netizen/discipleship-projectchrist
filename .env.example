APP_NAME=DisciplePath
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://discipleship.projectchrist.org
APP_TIMEZONE=UTC

LOG_CHANNEL=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database (Hostinger MySQL) ────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# ── Session & Cache (file-based for shared hosting) ──────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.projectchrist.org

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=disciplepath_

# ── Sanctum (SPA token auth) ──────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=discipleship.projectchrist.org

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://discipleship.projectchrist.org

# ── Anthropic AI ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your_key_here
ANTHROPIC_MODEL=claude-sonnet-5

# ── Mail (Hostinger email) ────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mail.projectchrist.org
MAIL_PORT=465
MAIL_USERNAME=noreply@projectchrist.org
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@projectchrist.org
MAIL_FROM_NAME="DisciplePath"

# ── MFA ──────────────────────────────────────────────────────────────────────
MFA_ISSUER="DisciplePath"

# ── File Uploads (KB) ────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE_KB=10240
